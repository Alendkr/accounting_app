<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10" stylesheets="@../../../styles.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.diplom.accounting_app.controllers.AddCategoryDialogController">

    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Введите название категории" />
    <TextField fx:id="categoryNameField" maxWidth="200" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleSave" text="Добавить" />
        <Button onAction="#handleCancel" text="Отмена" />
    </HBox>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

</VBox>
